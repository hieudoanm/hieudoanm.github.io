    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"

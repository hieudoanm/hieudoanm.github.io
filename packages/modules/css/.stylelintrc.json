{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "scss/comment-no-empty": null,
    "property-no-vendor-prefix": null,
    "property-no-deprecated": [
      true,
      {
        "ignoreProperties": ["-webkit-box-orient"]
      }
    ],
    "value-keyword-case": [
      "lower",
      {
        "ignoreProperties": ["font-family", "font", "font-synthesis"],
        "ignoreKeywords": [
          "Roboto",
          "Arial",
          "Georgia",
          "Cambria",
          "Times",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "optimizeLegibility"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/core/_highlight.scss"],
      "rules": {
        "selector-class-pattern": null
      }
    }
  ]
}

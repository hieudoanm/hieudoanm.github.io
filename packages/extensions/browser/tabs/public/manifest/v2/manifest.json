{
  "name": "Tabs",
  "version": "0.0.1",
  "description": "Redirect new tabs to the hieudoanm home page, capture the current view or the full scrolling page, and block distracting sites.",
  "author": "Hieu Doan",
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabs-extension@hieudoanm.github.io"
    }
  },
  "homepage_url": "https://hieudoanm.github.io",
  "offline_enabled": true,
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Tabs",
    "default_icon": {
      "128": "icons/128x128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "manifest_version": 2
}

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "brainbow",
  "version": "0.0.1",
  "identifier": "io.github.hieudoanm.brainbow",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Brainbow",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hieudoanm/hieudoanm.github.io/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MTMzNDMxMjlCRjVCMDkKUlFXSjc4cE1UUXh4MEU1bWZhd1lEUFE2ajRiOUl5SlJjNGFIcFlVckV6OTRycStEdFAzYnhsTw==",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": ["brainbow"],
        "name": "Brainbow project",
        "description": "Brainbow annotation project bundle",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Work": {
      "type": "object",
      "properties": {
        "doi": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "default": ""
        },
        "author": {
          "type": "string",
          "default": ""
        },
        "year": {
          "type": "string",
          "default": ""
        },
        "abstract": {
          "type": "string",
          "default": ""
        },
        "type": {
          "type": "string",
          "default": ""
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Reference"
          }
        },
        "referencedBy": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Reference"
          }
        }
      }
    },
    "Reference": {
      "type": "object",
      "properties": {
        "work": {
          "$ref": "#/definitions/Work"
        },
        "referenced": {
          "$ref": "#/definitions/Work"
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "work": {
      "$ref": "#/definitions/Work"
    },
    "reference": {
      "$ref": "#/definitions/Reference"
    }
  }
}

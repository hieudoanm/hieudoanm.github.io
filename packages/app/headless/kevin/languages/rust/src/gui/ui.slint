// kevin key/value manager — built with the Material design style.
//
// All display strings (row numbers, count) are pre-formatted in Rust to keep
// the markup free of string interpolation.

import { Button, LineEdit, ScrollView, VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";

export struct RowData {
    index: int,
    no: string,
    key: string,
    value: string,
}

export component MainWindow inherits Window {
    title: "kevin — Key/Value";
    width: 900px;
    height: 600px;

    in-out property <[RowData]> rows;
    in-out property <string> status-text: "";
    in-out property <string> count-text: "";
    in-out property <string> key-text: "";
    in-out property <string> value-text: "";

    callback set-clicked();
    callback refresh-clicked();
    callback delete-all-clicked();
    callback search-changed(string);
    callback edit(int);
    callback copy(int);
    callback delete(int);

    VerticalBox {
        padding: 8px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                placeholder-text: "key / search";
                text <=> key-text;
                edited(text) => { root.search-changed(text); }
            }
            LineEdit {
                placeholder-text: "value";
                text <=> value-text;
            }
            Button {
                text: "Set";
                clicked => { root.set-clicked(); }
            }
            Button {
                text: "Refresh";
                clicked => { root.refresh-clicked(); }
            }
            Button {
                text: "Delete All";
                clicked => { root.delete-all-clicked(); }
            }
        }

        // column headers
        HorizontalBox {
            spacing: 4px;
            Text { text: "No"; width: 40px; horizontal-alignment: center; }
            Text { text: "Key"; width: 220px; }
            Text { text: "Value"; }
            Text { text: "Edit"; width: 64px; horizontal-alignment: center; }
            Text { text: "Copy"; width: 64px; horizontal-alignment: center; }
            Text { text: "Delete"; width: 64px; horizontal-alignment: center; }
        }

        ScrollView {
            ListView {
                for row in root.rows: HorizontalBox {
                    spacing: 4px;
                    Text { text: row.no; width: 40px; horizontal-alignment: center; }
                    Text { text: row.key; width: 220px; }
                    Text { text: row.value; }
                    Button {
                        width: 64px;
                        text: "Edit";
                        clicked => { root.edit(row.index); }
                    }
                    Button {
                        width: 64px;
                        text: "Copy";
                        clicked => { root.copy(row.index); }
                    }
                    Button {
                        width: 64px;
                        text: "Delete";
                        clicked => { root.delete(row.index); }
                    }
                }
            }
        }

        HorizontalBox {
            Text { text: root.status-text; }
            Text { text: root.count-text; }
        }
    }
}
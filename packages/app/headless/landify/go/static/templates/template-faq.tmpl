<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{.Site.Description}}" />
    <title>{{.Site.Name}}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{{template "base-css" .}}
      .faq {
        max-width: 760px;
        margin: 0 auto;
      }
      .faq details {
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        background: var(--base-200);
        padding: 18px 22px;
      }
      .faq details + details {
        margin-top: 12px;
      }
      .faq summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        cursor: pointer;
        list-style: none;
        font-size: 16px;
        font-weight: 700;
      }
      .faq summary::-webkit-details-marker {
        display: none;
      }
      .faq summary::after {
        content: "+";
        font-size: 20px;
        line-height: 1;
        color: var(--primary);
      }
      .faq details[open] summary::after {
        content: "–";
      }
      .faq details p {
        margin: 12px 0 0;
        font-size: 14.5px;
        color: var(--neutral);
      }
    </style>
  </head>
  <body>
    {{template "header" .}}

    <main id="top">
      <section class="hero">
        <div>
          {{if .Hero.Badge}}<span class="badge">{{.Hero.Badge}}</span>{{end}}
          <h1>{{.Hero.Headline}}</h1>
          <p class="lead">{{.Hero.Subheadline}}</p>
        </div>
      </section>

      <section id="faq" class="block">
        {{if or .FAQ.Heading .FAQ.Sub}}
        <div class="block-head">
          <h2>{{.FAQ.Heading}}</h2>
          {{if .FAQ.Sub}}<p class="sub">{{.FAQ.Sub}}</p>{{end}}
        </div>
        {{end}}
        <div class="faq">
          {{range .FAQ.Items}}
          <details class="faq-item">
            <summary>{{.Question}}</summary>
            <p>{{.Answer}}</p>
          </details>
          {{end}}
        </div>
      </section>

      {{if .CTA.Heading}}
      <section id="cta" class="block">
        <div class="cta">
          <span class="icon" aria-hidden="true">{{.CTA.Icon}}</span>
          <h2>{{.CTA.Heading}}</h2>
          <p>{{.CTA.Body}}</p>
          <div class="actions">
            <a class="btn btn-primary" href="{{.CTA.Button.Href}}">{{.CTA.Button.Label}}</a>
          </div>
        </div>
      </section>
      {{end}}

      {{template "footer" .}}
    </main>
  </body>
</html>
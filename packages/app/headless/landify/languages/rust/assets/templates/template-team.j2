<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ config.site.description }}" />
    <title>{{ config.site.name }}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{% include 'base-css.j2' %}
      .values {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }
      .value {
        background: var(--base-200);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        padding: 24px;
        text-align: center;
      }
      .value .icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        font-size: 22px;
        border-radius: var(--radius);
        background: var(--primary-soft);
        border: 1px solid var(--border-soft);
      }
      .value h3 {
        margin: 14px 0 8px;
        font-size: 16px;
        font-weight: 700;
      }
      .value p {
        margin: 0;
        font-size: 13.5px;
        color: var(--neutral);
      }
      .members {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }
      .member {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        background: var(--base-200);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        padding: 28px 22px;
      }
      .member .avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        font-size: 30px;
        line-height: 1;
        background: var(--primary-soft);
        border: 2px solid var(--border-soft);
      }
      .member h3 {
        margin: 16px 0 2px;
        font-size: 17px;
        font-weight: 700;
      }
      .member .role {
        margin: 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--primary-dark);
      }
      .member .bio {
        margin: 10px 0 0;
        font-size: 13.5px;
        color: var(--neutral);
      }
      @media (max-width: 900px) {
        .values {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    {% include 'header.j2' %}

    <main id="top">
      <section class="hero">
        <div>
          {% if config.hero.badge %}<span class="badge">{{ config.hero.badge }}</span>{% endif %}
          <h1>{{ config.hero.headline }}</h1>
          <p class="lead">{{ config.hero.subheadline }}</p>
        </div>
      </section>

      {% if config.team.values %}
      <section id="values" class="block">
        {% if config.features.heading or config.features.sub %}
        <div class="block-head">
          <h2>{{ config.features.heading }}</h2>
          {% if config.features.sub %}<p class="sub">{{ config.features.sub }}</p>{% endif %}
        </div>
        {% endif %}
        <div class="values">
          {% for value in config.team.values %}
          <div class="value">
            <span class="icon" aria-hidden="true">{{ value.icon }}</span>
            <h3>{{ value.title }}</h3>
            <p>{{ value.body }}</p>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <section id="team" class="block">
        {% if config.team.heading or config.team.sub %}
        <div class="block-head">
          <h2>{{ config.team.heading }}</h2>
          {% if config.team.sub %}<p class="sub">{{ config.team.sub }}</p>{% endif %}
        </div>
        {% endif %}
        <div class="members">
          {% for member in config.team.members %}
          <div class="member">
            {% if member.avatar %}<span class="avatar" aria-hidden="true">{{ member.avatar }}</span>{% endif %}
            <h3>{{ member.name }}</h3>
            <p class="role">{{ member.role }}</p>
            {% if member.bio %}<p class="bio">{{ member.bio }}</p>{% endif %}
          </div>
          {% endfor %}
        </div>
      </section>

      {% if config.cta.heading %}
      <section id="cta" class="block">
        <div class="cta">
          <span class="icon" aria-hidden="true">{{ config.cta.icon }}</span>
          <h2>{{ config.cta.heading }}</h2>
          <p>{{ config.cta.body }}</p>
          <div class="actions">
            <a class="btn btn-primary" href="{{ config.cta.button.href }}">{{ config.cta.button.label }}</a>
          </div>
        </div>
      </section>
      {% endif %}

      {% include 'footer.j2' %}
    </main>
  </body>
</html>
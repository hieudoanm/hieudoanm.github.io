<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ config.site.description }}" />
    <title>{{ config.site.name }}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{% include 'base-css.j2' %}
      .status-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        max-width: 760px;
        margin: 0 auto;
        padding: 20px 24px;
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        background: var(--base-200);
      }
      .status-dot {
        flex: none;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--success);
      }
      .status-banner strong {
        text-transform: capitalize;
        font-size: 17px;
      }
      .status-updated {
        display: block;
        font-size: 13px;
        color: var(--neutral);
      }
      .status-banner.st-degraded .status-dot,
      .status-banner.st-maintenance .status-dot {
        background: var(--warning);
      }
      .status-banner.st-outage .status-dot {
        background: var(--error);
      }
      .status-announcement {
        max-width: 760px;
        margin: 16px auto 0;
        padding: 14px 18px;
        font-size: 14px;
        color: var(--primary-dark);
        background: var(--primary-soft);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        text-align: center;
      }
      .status-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 16px;
        max-width: 760px;
        margin: 32px auto 0;
      }
      .stat {
        background: var(--base-200);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        padding: 18px;
        text-align: center;
      }
      .stat-value {
        display: block;
        font-size: 24px;
        font-weight: 800;
        color: var(--primary);
      }
      .stat-label {
        display: block;
        margin-top: 2px;
        font-size: 12.5px;
        color: var(--neutral);
      }
      .incidents {
        max-width: 760px;
        margin: 0 auto;
      }
      .incident {
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        background: var(--base-200);
        padding: 16px 20px;
      }
      .incident + .incident {
        margin-top: 12px;
      }
      .incident-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 10px;
      }
      .incident-date {
        font-size: 12px;
        font-weight: 600;
        color: var(--neutral);
      }
      .incident-title {
        font-size: 15px;
        font-weight: 700;
      }
      .inc-pill {
        margin-left: auto;
        font-size: 11px;
        font-weight: 700;
        text-transform: capitalize;
        padding: 3px 10px;
        border-radius: 999px;
        color: var(--info);
        background: var(--base-300);
      }
      .inc-investigating {
        color: var(--warning);
      }
      .inc-monitoring {
        color: var(--info);
      }
      .inc-resolved {
        color: var(--success);
      }
      .incident p {
        margin: 8px 0 0;
        font-size: 13.5px;
        color: var(--neutral);
      }
    </style>
  </head>
  <body>
    {% include 'header.j2' %}

    <main id="top">
      <section class="hero">
        <div>
          {% if config.hero.badge %}<span class="badge">{{ config.hero.badge }}</span>{% endif %}
          <h1>{{ config.hero.headline }}</h1>
          <p class="lead">{{ config.hero.subheadline }}</p>
        </div>
      </section>

      <section id="status" class="block">
        <div class="status-banner st-{{ config.status.state }}">
          <span class="status-dot" aria-hidden="true"></span>
          <div>
            <strong>{{ config.status.state }}</strong>
            {% if config.status.updated %}<span class="status-updated">Updated {{ config.status.updated }}</span>{% endif %}
          </div>
        </div>

        {% if config.status.announcement %}
        <div class="status-announcement">{{ config.status.announcement }}</div>
        {% endif %}

        {% if config.status.stats %}
        <div class="status-stats">
          {% for stat in config.status.stats %}
          <div class="stat">
            <span class="stat-value">{{ stat.value }}</span>
            <span class="stat-label">{{ stat.label }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if config.status.incidents %}
        <div class="block-head" style="margin-top: 32px;">
          <h2>{{ config.status.heading }}</h2>
          {% if config.status.sub %}<p class="sub">{{ config.status.sub }}</p>{% endif %}
        </div>
        <div class="incidents">
          {% for incident in config.status.incidents %}
          <div class="incident">
            <div class="incident-head">
              <span class="incident-date">{{ incident.date }}</span>
              <span class="incident-title">{{ incident.title }}</span>
              {% if incident.state %}<span class="inc-pill inc-{{ incident.state }}">{{ incident.state }}</span>{% endif %}
            </div>
            {% if incident.body %}<p>{{ incident.body }}</p>{% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </section>

      {% if config.cta.heading %}
      <section id="cta" class="block">
        <div class="cta">
          <span class="icon" aria-hidden="true">{{ config.cta.icon }}</span>
          <h2>{{ config.cta.heading }}</h2>
          <p>{{ config.cta.body }}</p>
          <div class="actions">
            <a class="btn btn-primary" href="{{ config.cta.button.href }}">{{ config.cta.button.label }}</a>
          </div>
        </div>
      </section>
      {% endif %}

      {% include 'footer.j2' %}
    </main>
  </body>
</html>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ config.site.description }}" />
    <title>{{ config.site.name }}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{% include 'base-css.j2' %}
      .pricing {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        align-items: stretch;
        max-width: 900px;
        margin: 0 auto;
      }
      .tier {
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: var(--base-200);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        padding: 26px 24px;
      }
      .tier.featured {
        border: 2px solid var(--primary);
        background: var(--primary-soft);
      }
      .tier-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }
      .tier-name {
        font-size: 16px;
        font-weight: 800;
      }
      .tier-tag {
        font-size: 11px;
        font-weight: 600;
        color: var(--primary-dark);
        background: var(--primary);
        border-radius: 999px;
        padding: 3px 10px;
      }
      .tier-tag {
        color: var(--primary-content);
      }
      .tier-price {
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .tier-period {
        font-size: 14px;
        font-weight: 500;
        color: var(--neutral);
      }
      .perks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 8px;
        font-size: 14px;
        color: var(--base-content);
        flex: 1;
      }
      .perks li {
        display: flex;
        gap: 8px;
        align-items: baseline;
      }
      .perks .tick {
        color: var(--success);
        font-weight: 700;
      }
      .tier-cta .btn {
        width: 100%;
        margin-top: 6px;
      }
      .pricing-note {
        margin: 16px auto 0;
        max-width: 56ch;
        text-align: center;
        font-size: 13px;
        color: var(--neutral);
      }
      @media (max-width: 900px) {
        .pricing {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    {% include 'header.j2' %}

    <main id="top">
      <section class="hero">
        <div>
          {% if config.hero.badge %}<span class="badge">{{ config.hero.badge }}</span>{% endif %}
          <h1>{{ config.hero.headline }}</h1>
          <p class="lead">{{ config.hero.subheadline }}</p>
          {% if config.hero.primary.href or config.hero.secondary.href %}
          <div class="hero-actions">
            {% if config.hero.primary.href %}<a class="btn btn-primary" href="{{ config.hero.primary.href }}">{{ config.hero.primary.label }}</a>{% endif %}
            {% if config.hero.secondary.href %}<a class="btn btn-ghost" href="{{ config.hero.secondary.href }}">{{ config.hero.secondary.label }}</a>{% endif %}
          </div>
          {% endif %}
        </div>
      </section>

      {% if config.pricing.heading %}
      <section id="pricing" class="block">
        <div class="block-head">
          <h2>{{ config.pricing.heading }}</h2>
          {% if config.pricing.sub %}<p class="sub">{{ config.pricing.sub }}</p>{% endif %}
        </div>
        <div class="pricing">
          {% for tier in config.pricing.tiers %}
          <div class="tier{% if tier.tag %} featured{% endif %}">
            <div class="tier-head">
              <span class="tier-name">{{ tier.name }}</span>
              {% if tier.tag %}<span class="tier-tag">{{ tier.tag }}</span>{% endif %}
            </div>
            <div class="tier-price">{{ tier.price }}<span class="tier-period">{% if tier.period %} / {{ tier.period }}{% endif %}</span></div>
            <ul class="perks">
              {% for perk in tier.perks %}<li><span class="tick" aria-hidden="true">✓</span> {{ perk }}</li>{% endfor %}
            </ul>
            <div class="tier-cta">
              <a class="btn btn-primary" href="{{ tier.cta.href }}">{{ tier.cta.label }}</a>
            </div>
          </div>
          {% endfor %}
        </div>
        {% if config.pricing.note %}<p class="pricing-note">{{ config.pricing.note }}</p>{% endif %}
      </section>
      {% endif %}

      {% if config.cta.heading %}
      <section id="cta" class="block">
        <div class="cta">
          <span class="icon" aria-hidden="true">{{ config.cta.icon }}</span>
          <h2>{{ config.cta.heading }}</h2>
          <p>{{ config.cta.body }}</p>
          <div class="actions">
            <a class="btn btn-primary" href="{{ config.cta.button.href }}">{{ config.cta.button.label }}</a>
          </div>
        </div>
      </section>
      {% endif %}

      {% include 'footer.j2' %}
    </main>
  </body>
</html>
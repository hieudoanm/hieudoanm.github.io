<svg xmlns="http://www.w3.org/2000/svg" width="{{.Frame.Width}}" height="{{.Frame.Height}}" viewBox="0 0 {{.Frame.Width}} {{.Frame.Height}}" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif">
  <title>{{esc .Title}}</title>
  <desc>{{esc .Desc}}</desc>
  <defs>
    <linearGradient id="og-base" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{.Colors.Base}}" />
      <stop offset="1" stop-color="{{.Colors.BaseAlt}}" />
    </linearGradient>
    <radialGradient id="og-glow" cx="0.88" cy="0.04" r="0.58">
      <stop offset="0" stop-color="{{.Colors.Glow}}" stop-opacity="0.17" />
      <stop offset="1" stop-color="{{.Colors.Glow}}" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="og-accent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{.Colors.Accent}}" />
      <stop offset="1" stop-color="{{.Colors.AccentDeep}}" />
    </linearGradient>
    <filter id="og-shadow" x="-20%" y="-20%" width="150%" height="150%">
      <feDropShadow dx="0" dy="12" stdDeviation="18" flood-color="#000000" flood-opacity="0.16" />
    </filter>
  </defs>

  <rect x="0" y="0" width="{{.Frame.Width}}" height="{{.Frame.Height}}" fill="url(#og-base)" />
  <rect x="0" y="0" width="{{.Frame.Width}}" height="{{.Frame.Height}}" fill="url(#og-glow)" />
  <rect x="0" y="0" width="{{.Frame.Rail}}" height="{{.Frame.Height}}" fill="url(#og-accent)" />

  <g>
    <rect x="{{.Frame.Pad}}" y="{{.Frame.HeadY}}" width="{{.Frame.Tile}}" height="{{.Frame.Tile}}" rx="{{.Frame.TileRadius}}" fill="url(#og-accent)" />
    <text x="{{.Frame.MonogramX}}" y="{{.Frame.Baseline}}" text-anchor="middle" font-size="{{.Frame.MonogramSize}}" font-weight="800" fill="{{.Colors.AccentOnDark}}">{{esc .Monogram}}</text>
    <text x="{{.Frame.NameX}}" y="{{.Frame.Baseline}}" font-size="{{.Type.Name}}" font-weight="600" fill="{{.Colors.Ink}}">{{esc .Site}}</text>
    {{- if .Host}}
    <text x="{{.Frame.Edge}}" y="{{.Frame.HostBaseline}}" text-anchor="end" font-size="{{.Type.Host}}" fill="{{.Colors.Muted}}">{{esc .Host}}</text>
    {{- end}}
  </g>
  <line x1="{{.Frame.Pad}}" y1="{{.Frame.RuleY}}" x2="{{.Frame.Edge}}" y2="{{.Frame.RuleY}}" stroke="{{.Colors.Hairline}}" stroke-width="2" />

  <g font-size="{{.Type.Kicker}}" font-weight="700" letter-spacing="0.16em" fill="{{.Colors.AccentInk}}">
    {{- if .Kicker}}
    <text x="{{.Frame.Pad}}" y="{{.Type.KickerY}}">{{esc .Kicker}}</text>
    {{- end}}
  </g>
  <g font-size="{{.Type.Title}}" font-weight="800" fill="{{.Colors.Ink}}" letter-spacing="-0.022em">{{range $i, $line := .Lines}}
  <text x="{{$.Frame.Pad}}" y="{{lineY $.Type.TitleY $.Type.TitleStep $i}}">{{esc $line}}</text>{{end}}
  </g>
  <g font-size="{{.Type.Description}}" fill="{{.Colors.Muted}}">{{range $i, $line := .DescRuns}}
  <text x="{{$.Frame.Pad}}" y="{{lineY $.Type.DescriptionY $.Type.DescStep $i}}">{{esc $line}}</text>{{end}}
  </g>

  <g>
    <rect x="{{.Panel.X}}" y="{{.Panel.Y}}" width="{{.Panel.W}}" height="{{.Panel.H}}" rx="{{.Panel.Radius}}" fill="{{.Colors.Panel}}" stroke="{{.Colors.PanelLine}}" stroke-width="1.5" filter="url(#og-shadow)" />
    <rect x="{{.Panel.TileX}}" y="{{.Panel.TileY}}" width="{{.Panel.Tile}}" height="{{.Panel.Tile}}" rx="{{.Panel.TileRadius}}" fill="url(#og-accent)" />
    <text x="{{.Panel.MonogramX}}" y="{{.Panel.MonogramY}}" text-anchor="middle" font-size="{{.Panel.Monogram}}" font-weight="800" fill="{{.Colors.AccentOnDark}}">{{esc .Monogram}}</text>
    {{- range .Pills}}
    <rect x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="{{.H}}" rx="{{.Radius}}" fill="{{$.Colors.Pill}}" />
    <circle cx="{{.DotX}}" cy="{{.DotY}}" r="{{.DotR}}" fill="{{$.Colors.Accent}}" />
    <text x="{{.TextX}}" y="{{.TextY}}" font-size="{{$.Panel.PillSize}}" font-weight="500" fill="{{$.Colors.Ink}}">{{esc .Label}}</text>
    {{- end}}
  </g>
</svg>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{.Site.Description}}" />
    <title>{{.Site.Name}}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{{template "base-css" .}}
      .waitlist-panel {
        max-width: 640px;
        margin: 0 auto;
        text-align: center;
        background: var(--base-200);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        padding: 40px 32px;
      }
      .waitlist-panel .lead {
        margin: 10px auto 24px;
      }
      .launch-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        background: var(--primary-soft);
        color: var(--primary-dark);
      }
      .waitlist-form {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        max-width: 460px;
        margin: 0 auto;
      }
      .waitlist-form input[type="email"] {
        flex: 1 1 220px;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--base-100);
        color: var(--base-content);
        padding: 12px 16px;
        font-size: 15px;
        font-family: inherit;
      }
      .waitlist-form input:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 1px;
      }
      .socials {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 22px;
      }
      .social {
        font-size: 13px;
        font-weight: 600;
        color: var(--base-content);
        background: var(--base-100);
        border: 1px solid var(--border-soft);
        border-radius: 999px;
        padding: 6px 14px;
      }
      .social:hover {
        text-decoration: none;
        background: var(--base-300);
      }
    </style>
  </head>
  <body>
    {{template "header" .}}

    <main id="top">
      <section class="hero">
        <div>
          {{if .Hero.Badge}}<span class="badge">{{.Hero.Badge}}</span>{{end}}
          <h1>{{.Hero.Headline}}</h1>
          <p class="lead">{{.Hero.Subheadline}}</p>
        </div>
      </section>

      <section id="join" class="block">
        <div class="waitlist-panel">
          <span class="launch-chip">{{.Waitlist.Launches}}</span>
          <h2>{{.Waitlist.Heading}}</h2>
          <p class="lead">{{.Waitlist.Body}}</p>
          <form class="waitlist-form" method="post" action="{{.Waitlist.Form.Action}}">
            <input type="email" name="email" placeholder="{{.Waitlist.Form.Placeholder}}" aria-label="Email address" required />
            <button type="submit" class="btn btn-primary">{{.Waitlist.Form.Button}}</button>
          </form>
          {{if .Waitlist.Social}}
          <div class="socials">
            {{range .Waitlist.Social}}<a href="{{.Href}}" class="social">{{.Label}}</a>{{end}}
          </div>
          {{end}}
        </div>
      </section>

      {{if .Features.Items}}
      <section id="features" class="block">
        <div class="block-head">
          <h2>{{.Features.Heading}}</h2>
          <p class="sub">{{.Features.Sub}}</p>
        </div>
        <div class="features">
          {{range .Features.Items}}
          <div class="feature">
            <span class="icon">{{.Icon}}</span>
            <h3>{{.Title}}</h3>
            <p>{{.Body}}</p>
          </div>
          {{end}}
        </div>
      </section>
      {{end}}

      {{template "footer" .}}
    </main>
  </body>
</html>
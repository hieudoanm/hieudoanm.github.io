<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ config.site.description }}" />
    <title>{{ config.site.name }}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{% include 'base-css.j2' %}
      .pfolio {
        text-align: center;
        max-width: 760px;
        margin: 0 auto;
        padding-top: 12px;
      }
      .avatar-lg {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 96px;
        height: 96px;
        border-radius: 50%;
        border: 2px solid var(--primary);
        background: var(--primary-soft);
        font-size: 44px;
        line-height: 1;
      }
      .pfolio h1 {
        margin: 16px 0 8px;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .pfolio .role {
        font-size: 17px;
        color: var(--neutral);
      }
      .pfolio .loc {
        display: inline-block;
        margin-top: 12px;
        font-size: 12px;
        font-weight: 600;
        color: var(--neutral);
        border: 1px solid var(--border-soft);
        border-radius: 999px;
        padding: 5px 14px;
      }
      .pfolio .about {
        margin: 18px auto 0;
        font-size: 15px;
        color: var(--base-content);
      }
      .skills {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
      }
      .skill {
        font-size: 12px;
        font-weight: 600;
        color: var(--primary-dark);
        background: var(--secondary-soft);
        border-radius: 999px;
        padding: 6px 14px;
      }
      .projects {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        max-width: 760px;
        margin: 0 auto;
      }
      .project {
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: var(--base-200);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        padding: 22px 20px;
        color: var(--base-content);
        text-decoration: none;
      }
      .project:hover {
        border-color: var(--primary);
        color: var(--primary);
      }
      .project h3 {
        font-size: 16px;
        font-weight: 700;
        margin: 0;
      }
      .project p {
        margin: 0;
        font-size: 14px;
        color: var(--neutral);
      }
      @media (max-width: 720px) {
        .projects {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    {% include 'header.j2' %}

    <main id="top">
      <section class="pfolio">
        {% if config.portfolio.avatar %}<span class="avatar-lg" aria-hidden="true">{{ config.portfolio.avatar }}</span>{% endif %}
        <h1>{{ config.portfolio.name }}</h1>
        <p class="role">{{ config.portfolio.role }}</p>
        {% if config.portfolio.location %}<span class="loc">📍 {{ config.portfolio.location }}</span>{% endif %}
        <p class="about">{{ config.portfolio.about }}</p>
        {% if config.portfolio.skills %}
        <div class="skills">
          {% for skill in config.portfolio.skills %}<span class="skill">{{ skill }}</span>{% endfor %}
        </div>
        {% endif %}
      </section>

      <section id="work" class="block">
        {% if config.features.heading or config.features.sub %}
        <div class="block-head">
          <h2>{{ config.features.heading }}</h2>
          {% if config.features.sub %}<p class="sub">{{ config.features.sub }}</p>{% endif %}
        </div>
        {% endif %}
        <div class="projects">
          {% for project in config.portfolio.projects %}
          <a class="project" href="{{ project.href }}">
            <span class="icon" aria-hidden="true">{{ project.icon }}</span>
            <h3>{{ project.title }}</h3>
            <p>{{ project.body }}</p>
          </a>
          {% endfor %}
        </div>
      </section>

      {% if config.cta.heading %}
      <section id="cta" class="block">
        <div class="cta">
          <span class="icon" aria-hidden="true">{{ config.cta.icon }}</span>
          <h2>{{ config.cta.heading }}</h2>
          <p>{{ config.cta.body }}</p>
          <div class="actions">
            <a class="btn btn-primary" href="{{ config.cta.button.href }}">{{ config.cta.button.label }}</a>
          </div>
        </div>
      </section>
      {% endif %}

      {% include 'footer.j2' %}
    </main>
  </body>
</html>
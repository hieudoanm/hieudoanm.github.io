<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ config.site.description }}" />
    <title>{{ config.site.name }}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{% include 'base-css.j2' %}
      .waitlist-panel {
        max-width: 640px;
        margin: 0 auto;
        text-align: center;
        background: var(--base-200);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        padding: 40px 32px;
      }
      .waitlist-panel .lead {
        margin: 10px auto 24px;
      }
      .launch-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        background: var(--primary-soft);
        color: var(--primary-dark);
      }
      .waitlist-form {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        max-width: 460px;
        margin: 0 auto;
      }
      .waitlist-form input[type="email"] {
        flex: 1 1 220px;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--base-100);
        color: var(--base-content);
        padding: 12px 16px;
        font-size: 15px;
        font-family: inherit;
      }
      .waitlist-form input:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 1px;
      }
      .socials {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 22px;
      }
      .social {
        font-size: 13px;
        font-weight: 600;
        color: var(--base-content);
        background: var(--base-100);
        border: 1px solid var(--border-soft);
        border-radius: 999px;
        padding: 6px 14px;
      }
      .social:hover {
        text-decoration: none;
        background: var(--base-300);
      }
    </style>
  </head>
  <body>
    {% include 'header.j2' %}

    <main id="top">
      <section class="hero">
        <div>
          {% if config.hero.badge %}<span class="badge">{{ config.hero.badge }}</span>{% endif %}
          <h1>{{ config.hero.headline }}</h1>
          <p class="lead">{{ config.hero.subheadline }}</p>
        </div>
      </section>

      <section id="join" class="block">
        <div class="waitlist-panel">
          <span class="launch-chip">{{ config.waitlist.launches }}</span>
          <h2>{{ config.waitlist.heading }}</h2>
          <p class="lead">{{ config.waitlist.body }}</p>
          <form class="waitlist-form" method="post" action="{{ config.waitlist.form.action }}">
            <input type="email" name="email" placeholder="{{ config.waitlist.form.placeholder }}" aria-label="Email address" required />
            <button type="submit" class="btn btn-primary">{{ config.waitlist.form.button }}</button>
          </form>
          {% if config.waitlist.social %}
          <div class="socials">
            {% for social in config.waitlist.social %}<a href="{{ social.href }}" class="social">{{ social.label }}</a>{% endfor %}
          </div>
          {% endif %}
        </div>
      </section>

      {% if config.features.items %}
      <section id="features" class="block">
        <div class="block-head">
          <h2>{{ config.features.heading }}</h2>
          <p class="sub">{{ config.features.sub }}</p>
        </div>
        <div class="features">
          {% for feature in config.features.items %}
          <div class="feature">
            <span class="icon">{{ feature.icon }}</span>
            <h3>{{ feature.title }}</h3>
            <p>{{ feature.body }}</p>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% include 'footer.j2' %}
    </main>
  </body>
</html>
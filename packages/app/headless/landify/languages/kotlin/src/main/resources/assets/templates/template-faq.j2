<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ config.site.description }}" />
    <title>{{ config.site.name }}</title>
    <style>
      :root {
@LANDIFY_THEME@      }
{% include 'base-css.j2' %}
      .faq {
        max-width: 760px;
        margin: 0 auto;
      }
      .faq details {
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        background: var(--base-200);
        padding: 18px 22px;
      }
      .faq details + details {
        margin-top: 12px;
      }
      .faq summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        cursor: pointer;
        list-style: none;
        font-size: 16px;
        font-weight: 700;
      }
      .faq summary::-webkit-details-marker {
        display: none;
      }
      .faq summary::after {
        content: "+";
        font-size: 20px;
        line-height: 1;
        color: var(--primary);
      }
      .faq details[open] summary::after {
        content: "–";
      }
      .faq details p {
        margin: 12px 0 0;
        font-size: 14.5px;
        color: var(--neutral);
      }
    </style>
  </head>
  <body>
    {% include 'header.j2' %}

    <main id="top">
      <section class="hero">
        <div>
          {% if config.hero.badge %}<span class="badge">{{ config.hero.badge }}</span>{% endif %}
          <h1>{{ config.hero.headline }}</h1>
          <p class="lead">{{ config.hero.subheadline }}</p>
        </div>
      </section>

      <section id="faq" class="block">
        {% if config.faq.heading or config.faq.sub %}
        <div class="block-head">
          <h2>{{ config.faq.heading }}</h2>
          {% if config.faq.sub %}<p class="sub">{{ config.faq.sub }}</p>{% endif %}
        </div>
        {% endif %}
        <div class="faq">
          {% for item in config.faq.items %}
          <details class="faq-item">
            <summary>{{ item.question }}</summary>
            <p>{{ item.answer }}</p>
          </details>
          {% endfor %}
        </div>
      </section>

      {% if config.cta.heading %}
      <section id="cta" class="block">
        <div class="cta">
          <span class="icon" aria-hidden="true">{{ config.cta.icon }}</span>
          <h2>{{ config.cta.heading }}</h2>
          <p>{{ config.cta.body }}</p>
          <div class="actions">
            <a class="btn btn-primary" href="{{ config.cta.button.href }}">{{ config.cta.button.label }}</a>
          </div>
        </div>
      </section>
      {% endif %}

      {% include 'footer.j2' %}
    </main>
  </body>
</html>
<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs go to stderr, never stdout.

  `backbone mcp serve` speaks newline-delimited JSON-RPC on stdout, so any log
  line written there would be read by the client as a malformed frame. The
  default logback console appender targets System.out, so this is required
  rather than cosmetic.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- HikariCP logs its whole pool configuration at DEBUG on startup. -->
    <logger name="com.zaxxer.hikari" level="INFO" />

    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
